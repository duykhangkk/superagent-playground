{
  "manifest_version": 3,
  "name": "YT Upscale PURE - NVIDIA NIS Ultra Fluid",
  "version": "3.3.0",
  "description": "Nâng cấp video YouTube mượt mà 60+ FPS không rớt khung bằng NVIDIA Image Scaling (NIS) kết hợp bộ lọc song phương khử hạt (Smart Bilateral Denoise) cho card GeForce GTX/RTX.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cài đặt YT Upscale PURE",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
