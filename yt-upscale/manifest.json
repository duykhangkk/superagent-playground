{
  "manifest_version": 3,
  "name": "YT Upscale - Nâng cấp video YouTube WebGL",
  "version": "1.0.0",
  "description": "Nâng cấp khung hình video YouTube vượt độ phân giải gốc trong thời gian thực bằng WebGL (AMD FSR EASU & Lanczos-3).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cài đặt YT Upscale",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
